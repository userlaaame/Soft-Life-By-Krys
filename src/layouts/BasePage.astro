---
import '@fontsource/allura/400.css';
import '@fontsource-variable/karla';
import '@fontsource/dm-mono/400.css';
import '../styles/global.css';
import allura from '@fontsource/allura/files/allura-latin-400-normal.woff2?url';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const prelaunch = import.meta.env.PUBLIC_PRELAUNCH === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={allura} as="font" type="font/woff2" crossorigin />
    {(noindex || prelaunch) && <meta name="robots" content="noindex, nofollow" />} 
    <!-- Sec 12: shared links must preview correctly on Instagram and Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Soft Life by Krys" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Krys in a café in Frenchtown, New Jersey" />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>